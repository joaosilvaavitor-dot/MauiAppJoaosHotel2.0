<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.BoasVindas"
             Title="Boas-vindas"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Primary}">

    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center"
                             Padding="30"
                             Spacing="14">

          
            <Image Source="lobbydohotel.jpg"
                   HeightRequest="150"
                   Aspect="AspectFit" />

            <Label Text="Bem-vindo ao"
                   FontSize="Subtitle"
                   TextColor="{StaticResource Secondary}" />

            <Label Text="Joao´s Hotel"
                   FontFamily="Poppins"
                   FontSize="46"
                   TextColor="White" />

            <Label Text="Descanse, relaxe e aproveite. Sua estadia começa aqui."
                   FontSize="Body"
                   TextColor="{StaticResource Secondary}" />

            <Button Text="Fazer reserva"
                    Margin="0,20,0,0"
                    BackgroundColor="White"
                    TextColor="{StaticResource Primary}"
                    Clicked="Reserva_Clicked" />

            <Button Text="Ver promoções"
                    BackgroundColor="{StaticResource Tertiary}"
                    TextColor="White"
                    Clicked="Promocoes_Clicked" />

            <Button Text="Sobre o App"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    BorderColor="White"
                    BorderWidth="1"
                    Clicked="Sobre_Clicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
