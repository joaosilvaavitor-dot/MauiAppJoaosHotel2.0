<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout VerticalOptions="CenterAndExpand"
                         Padding="10"
                         Spacing="10">

        <!-- Troque pela sua foto: coloque o arquivo em Resources/Images -->
        <Image Source="dotnet_bot.png"
               HeightRequest="120"
               Aspect="AspectFit" />

        <Label Text="Sobre o App"
               FontFamily="Kalam"
               FontSize="44"
               TextColor="{StaticResource Primary}"
               HorizontalTextAlignment="Center" />

        <Frame Margin="10" Padding="15">
            <VerticalStackLayout Spacing="12">

                <VerticalStackLayout>
                    <Label Text="Aplicativo" TextTransform="Uppercase"
                           FontSize="Small" TextColor="{StaticResource Tertiary}" />
                    <Label Text="Joao´s Hotel"
                           FontSize="Subtitle" TextColor="{StaticResource Primary}" />
                </VerticalStackLayout>

                <VerticalStackLayout>
                    <Label Text="Desenvolvedor" TextTransform="Uppercase"
                           FontSize="Small" TextColor="{StaticResource Tertiary}" />
                    <Label Text="João"
                           FontSize="Subtitle" TextColor="{StaticResource Primary}" />
                </VerticalStackLayout>

                <VerticalStackLayout>
                    <Label Text="Ano de desenvolvimento" TextTransform="Uppercase"
                           FontSize="Small" TextColor="{StaticResource Tertiary}" />
                    <Label Text="2026"
                           FontSize="Subtitle" TextColor="{StaticResource Primary}" />
                </VerticalStackLayout>

                <VerticalStackLayout>
                    <Label Text="Curso" TextTransform="Uppercase"
                           FontSize="Small" TextColor="{StaticResource Tertiary}" />
                    <Label Text="Técnico em Desenvolvimento de Sistemas"
                           FontSize="Subtitle" TextColor="{StaticResource Primary}" />
                </VerticalStackLayout>

                <VerticalStackLayout>
                    <Label Text="Tecnologia" TextTransform="Uppercase"
                           FontSize="Small" TextColor="{StaticResource Tertiary}" />
                    <Label Text=".NET MAUI (C# e XAML)"
                           FontSize="Subtitle" TextColor="{StaticResource Primary}" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Frame>

        <Button Text="Voltar"
                HorizontalOptions="Center"
                Clicked="Button_Clicked" />

    </VerticalStackLayout>
</ContentPage>
