<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Promocoes"
             Title="Promoções"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="10" RowSpacing="10">

        <Label Grid.Row="0"
               Text="Promoções"
               FontFamily="Kalam"
               FontSize="44"
               TextColor="{StaticResource Primary}" />

        <!-- Cada item da lista usa o modelo (DataTemplate) abaixo -->
        <CollectionView Grid.Row="1" x:Name="lista_promocoes">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,0,0,10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                            <Label Grid.Column="0"
                                   Text="{Binding Emoji}"
                                   FontSize="36"
                                   VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding Titulo}"
                                       FontSize="Subtitle"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Start"
                                       TextColor="{StaticResource Primary}" />
                                <Label Text="{Binding Descricao}"
                                       HorizontalTextAlignment="Start" />
                                <Label Text="{Binding Destaque}"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Start"
                                       TextColor="{StaticResource Tertiary}" />
                            </VerticalStackLayout>

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2"
                Text="Voltar"
                HorizontalOptions="Center"
                Clicked="Voltar_Clicked" />
    </Grid>
</ContentPage>
